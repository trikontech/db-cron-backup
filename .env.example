# ==============================================================================
# Neon PostgreSQL -> Google Drive Backup Configuration
# ==============================================================================

# Neon PostgreSQL Database Connection String (Direct or Pooled)
# Get this from Neon Console: Dashboard -> Project -> Connection Details
DATABASE_URL="postgresql://neondb_owner:npg_secret123@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Drive Target Folder ID
# Open your Google Drive folder in browser: https://drive.google.com/drive/folders/YOUR_FOLDER_ID_HERE
GDRIVE_FOLDER_ID="1GMGzOVFOX8es6ZynsP9FbTWFquQK2BMv"

# Path to the Google Cloud Service Account JSON key file
SERVICE_ACCOUNT_KEY_FILE="./service-account-key.json"

# Local Backup Directory
LOCAL_BACKUP_DIR="./backups"

# Retention Policy (Days to keep before auto-deleting)
RETENTION_DAYS_LOCAL=7
RETENTION_DAYS_DRIVE=30

# Alerting / Notifications (Optional: Discord, Slack, or Telegram Webhook)
WEBHOOK_URL="https://discord.com/api/webhooks/123456789/abcdefghijk"

# Dead Man's Snitch / Healthchecks.io Ping URL (Optional)
HEALTHCHECK_URL="https://hc-ping.com/your-uuid-here"
